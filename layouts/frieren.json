{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.11"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "claude-sessions",
              "type": "block",
              "content": {
                "mod": "claude-sessions"
              },
              "size": {
                "weight": 1.6
              },
              "min": 120
            },
            {
              "id": "codex-sessions",
              "type": "block",
              "content": {
                "mod": "codex-sessions"
              },
              "size": {
                "weight": 1.6
              },
              "min": 120
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "topbar",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "usage",
              "type": "block",
              "content": {
                "mod": "usage-gauge"
              },
              "size": {
                "px": 818
              },
              "window_drag": true
            },
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs"
              },
              "window_drag": true
            },
            {
              "id": "smart-paste",
              "type": "block",
              "content": {
                "mod": "smart-paste"
              },
              "size": {
                "px": 0
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-account"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "results",
              "type": "block",
              "content": {
                "mod": "results-panel"
              },
              "size": {
                "px": 400
              },
              "min": 280,
              "max": 900,
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              },
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/frieren.jpg",
    "fit": "cover"
  },
  "theme": {
    "light": "frieren-paper",
    "dark": "frieren-ink"
  },
  "terminal_opacity": 0.2,
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/frieren.png"
}
